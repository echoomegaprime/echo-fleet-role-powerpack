{
  "name": "@echoomegaprime/echo-fleet-role-powerpack",
  "version": "1.3.0",
  "description": "Fleet role powerpack: governed MCP + canonical Codex echo-fleet-roles skills (sole role-skills source).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "echo-fleet-role-powerpack": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "remediate:codex": "python3 scripts/remediate_codex_plugins.py --lean",
    "verify:role-skills": "python3 scripts/verify_role_skills_budget.py"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/echoomegaprime/echo-fleet-role-powerpack.git"
  },
  "keywords": [
    "echo",
    "mcp",
    "oauth",
    "echoomegaprime",
    "echo-fleet-role-powerpack",
    "echo-fleet-roles",
    "codex-plugins"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
