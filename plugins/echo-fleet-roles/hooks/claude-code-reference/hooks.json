{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/role_context.py",
            "statusMessage": "Loading the selected ECHO fleet role"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/role_context.py",
            "statusMessage": "Applying ECHO role context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|MultiEdit|NotebookEdit|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/role_adoption_gate.py pre",
            "statusMessage": "ECHO role adoption gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/role_adoption_gate.py post",
            "statusMessage": "Recording loaded ECHO role skill"
          }
        ]
      },
      {
        "matcher": "Bash|Shell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/failure_signature_detector.py",
            "statusMessage": "ECHO failure-signature detector"
          }
        ]
      }
    ]
  }
}
